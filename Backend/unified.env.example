AZURE_SHARE_POINT_INDEXR_NAME=
AZURE_SHARE_POINT_INDEXES_NAME=

ENABLE_RERANKER=false
NVIDIA_RERANKER_MODEL=nvidia/llama-nemotron-rerank-1b-v2
RERANKER_TOP_N=3

ENABLE_GUARDRAILS=true
NVIDIA_GUARDRAIL_MODEL=nvidia/llama-3.1-nemoguard-8b-content-safety
GUARDRAIL_BLOCK_ON_FLAG=true
GUARDRAIL_HARD_BLOCK_ON_KEYWORDS=true
GUARDRAIL_RISK_BLOCK_THRESHOLD=2

# NAT policy agents (NIM JSON decisions inside unified_nat_orchestrator — no Python rule classes)
# Master switch: true = input + grounding + output agents run (unless a per-phase flag overrides).
ENABLE_NAT_POLICY_AGENTS=true
# Optional per-phase overrides (unset = follow ENABLE_NAT_POLICY_AGENTS)
# ENABLE_NAT_INPUT_POLICY=false
# ENABLE_NAT_GROUNDING_POLICY=false
# ENABLE_NAT_OUTPUT_POLICY=false
# If true, invalid JSON from a policy agent allows the request (log only). If false, blocks on parse failure.
NAT_POLICY_FAIL_OPEN=true

SUPER_ADMIN_PASSWORD=

GRAPH_RAG_EMBEDDING_MODEL_NAME=text-embedding-3-small
GRAPH_RAG_OPENAI_API_TYPE=azure_openai_chat
GRAPH_RAG_OPENAI_API_BASE=
GRAPH_RAG_OPENAI_API_VERSION=2024-02-01
GRAPH_RAG_OPENAI_API_KEY=
