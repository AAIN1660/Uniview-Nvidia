# Embeddings via NVIDIA (optional overrides)
EMBEDDING_BACKEND=nvidia
NVIDIA_EMBEDDING_API_KEY=
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_INPUT_TYPE=query
# If true, never fall back to Azure embeddings when NIM returns 404 (NVIDIA-only policy).
# NVIDIA_EMBEDDING_STRICT=1

# GraphRAG: indexer sends passage embeddings via graphrag_index_runner (+ patch).
# Query-time entity search uses the same NIM model; set passage side with:
# GRAPHRAG_INDEX_EMBEDDING_INPUT_TYPE=passage (default in runner).
# Use NVIDIA for both index and query (1024-dim for nv-embedqa-e5-v5):
GRAPH_RAG_EMBEDDING_BACKEND=nvidia
# Force Azure embeddings only for legacy 1536-dim Lance indices: GRAPH_RAG_EMBEDDING_BACKEND=azure
# Optional: full blob prefix under BLOB_STORAGE_CONTAINER_NAME (overrides category-based path):
# GRAPH_RAG_ARTIFACTS_FOLDER=graphragoutput/<category-uuid>/artifacts
# Optional default category if the request omits category (prefer fixing the client):
# GRAPH_RAG_DEFAULT_CATEGORY_ID=

# ---------------------------
# Blob storage
# ---------------------------
BLOB_STORAGE_CONNECTION_STRING=
BLOB_STORAGE_CONTAINER_NAME=

# Queue (GraphRAG)
AZURE_GRAPHRAG_QUEUE_STORAGE_NAME=

# ---------------------------
# SQL Database (used by utility/inference.py + unifiedServiceHelper.py)
# ---------------------------
SQL_HOST=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SCHEMA=dbo
SQL_ENCODING=ISO-8859-1

# ---------------------------
# GraphRAG / LanceDB paths (optional)
# ---------------------------
# GraphRAG indexing (data/settings.yaml): embeddings use openai_embedding -> NIM
# (NVIDIA_EMBEDDING_BASE_URL, NVIDIA_API_KEY, NVIDIA_EMBEDDING_MODEL). After any
# switch from Azure (1536-dim) to NVIDIA (1024-dim for nv-embedqa-e5-v5), you must
# re-index and publish artifacts to graphragoutput/<category>/artifacts or you will
# see LanceDB errors: "Query vector size 1024 does not match index column size 1536".
# LLM steps in settings.yaml may still use Azure OPENAI_* for GraphRAG build if desired.
GRAPH_RAG_OPENAI_API_BASE=
GRAPH_RAG_OPENAI_API_VERSION=2024-02-01
GRAPH_RAG_OPENAI_API_KEY=
GRAPH_RAG_LLM_MODEL=gpt-4o
# Legacy Azure embedding name (only if GRAPH_RAG_EMBEDDING_BACKEND=azure)
GRAPH_RAG_EMBEDDING_MODEL_NAME=text-embedding-3-small
GRAPHRAG_INDEX_EMBEDDING_INPUT_TYPE=passage
# Misc (utility/unifiedServiceHelper.py)
# ---------------------------
UNIFIED_CATEGORY_NAME=retail
UNIFIED_INDEX_NAME=ecommerce_data
UNIFIED_SEARCH_METHOD=vector

# ---------------------------
# Metadata / credits (Mongo-only balance path)
# ---------------------------
# ---------------------------
# NVIDIA Riva speech (local / self-hosted ASR + TTS via gRPC)
# ---------------------------
# Backend: pip install -r requirements-riva-speech.txt then run a Riva server
# (e.g. quickstart). Frontend: set VITE_APP_API_URL and VITE_RIVA_SPEECH (see Frontend/.env.example).
RIVA_SPEECH_URI=localhost:50051
# RIVA_SPEECH_SSL=false
# RIVA_SPEECH_SSL_ROOT_CERT=
RIVA_ASR_LANGUAGE=en-US
# RIVA_ASR_MODEL=
RIVA_TTS_LANGUAGE=en-US
# RIVA_TTS_VOICE=
RIVA_TTS_SAMPLE_RATE_HZ=24000

# ---------------------------
# Metadata / credits (Mongo-only balance path)
# ---------------------------
# Set METADATA_BACKEND=mongo in Backend/.env (see utility/helper.py). Credits,
# users, uploads, config, and the ``transactions`` collection must all live in
# that Mongo database. Balance for /generate_response and userCreditService
# reads the same Mongo ``transactions``; do not dual-write credits to Cosmos.
