# Copy this file to `unified.env` and fill in real values.
# NEVER commit `unified.env` (it contains secrets).

# ---------------------------
# Core runtime
# ---------------------------
TOKEN_PER_CREDIT=1000
chunk_size=4000

# ---------------------------
# Cosmos DB
# ---------------------------
COSMOS_DATABASE_NAME=
COSMOS_ENDPOINT=
COSMOS_KEY=
UPLOAD_CONTAINER_NAME=

# ---------------------------
# Azure Cognitive Search
# ---------------------------
AZURE_SEARCH_SERVICE_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_QA_INDEX_NAME=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SHARE_POINT_INDEXR_NAME=
AZURE_SHARE_POINT_INDEXES_NAME=

# ---------------------------
# Azure OpenAI (if using Azure backend)
# ---------------------------
OPENAI_API_TYPE=azure
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_API_KEY=
GPT3_LLM_MODEL_DEPLOYMENT_NAME=
GPT3_LLM_MODEL_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYED_MODEL=
AZURE_OPENAI_EMBEDDING_MODEL_NAME=
AZURE_OPENAI_API_REGION=

# ---------------------------
# NVIDIA NIM (OpenAI-compatible) (if using NVIDIA backend)
# ---------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Embeddings via NVIDIA (optional overrides)
EMBEDDING_BACKEND=nvidia
NVIDIA_EMBEDDING_API_KEY=
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_INPUT_TYPE=query

# ---------------------------
# Blob storage
# ---------------------------
BLOB_STORAGE_CONNECTION_STRING=
BLOB_STORAGE_CONTAINER_NAME=

# Queue (GraphRAG)
AZURE_GRAPHRAG_QUEUE_STORAGE_NAME=

# ---------------------------
# SQL Database (used by utility/inference.py + unifiedServiceHelper.py)
# ---------------------------
SQL_HOST=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SCHEMA=dbo
SQL_ENCODING=ISO-8859-1

# ---------------------------
# GraphRAG / LanceDB paths (optional)
# ---------------------------
GRAPHRAG_INPUT_DIR=Backend/artifacts
GRAPH_RAG_OPENAI_API_TYPE=azure
GRAPH_RAG_OPENAI_API_BASE=
GRAPH_RAG_OPENAI_API_VERSION=2024-02-01
GRAPH_RAG_OPENAI_API_KEY=
GRAPH_RAG_LLM_MODEL=gpt-4o
GRAPH_RAG_EMBEDDING_MODEL_NAME=text-embedding-3-small

# ---------------------------
# Misc (utility/unifiedServiceHelper.py)
# ---------------------------
UNIFIED_CATEGORY_NAME=retail
UNIFIED_INDEX_NAME=ecommerce_data
UNIFIED_SEARCH_METHOD=vector

